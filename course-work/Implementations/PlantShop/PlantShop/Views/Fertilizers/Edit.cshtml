    @model PlantShop.Models.Fertilizer

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Fertilizer</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NPKRatio" class="control-label"></label>
                <input asp-for="NPKRatio" class="form-control" />
                <span asp-validation-for="NPKRatio" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PricePerKg" class="control-label"></label>
                <input asp-for="PricePerKg" class="form-control" />
                <span asp-validation-for="PricePerKg" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InStockQuantity" class="control-label"></label>
                <input asp-for="InStockQuantity" class="form-control" />
                <span asp-validation-for="InStockQuantity" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsLiquid" /> @Html.DisplayNameFor(model => model.IsLiquid)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="CreatedOn" class="control-label"></label>
                <input asp-for="CreatedOn" class="form-control" />
                <span asp-validation-for="CreatedOn" class="text-danger"></span>
            </div>


            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
