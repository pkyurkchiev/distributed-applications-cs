@* @model IEnumerable<PlantShop.Models.Fertilizer> *@
@model PlantShop.Models.PaginatedList<PlantShop.Models.Fertilizer>


@{
    ViewData["Title"] = "Fertilizers";
}

<h1>Fertilizers</h1>

@* //User и Admin могат само да търсят*@
@if (User.IsInRole("User") || User.IsInRole("Admin"))
{
    <form asp-action="Index" method="get">
        <div class="row mb-3">
            <div class="col-md-4">
                <input type="text" name="searchName" value="@ViewData["SearchName"]" class="form-control" placeholder="Search by name..." />
            </div>

            <div class="col-md-4">
                <input type="text" name="searchNPK" value="@ViewData["SearchNPK"]" class="form-control" placeholder="Search by NPK..." />
            </div>

            <div class="col-md-4">
                <button class="btn btn-primary">Search</button>
                <a asp-action="Index" class="btn btn-secondary">Clear</a>
            </div>
        </div>
    </form>
}

@* // create само за admin *@
@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @* @Html.DisplayNameFor(model => model.Name) *@
                @if (User.IsInRole("User") || User.IsInRole("Admin"))
                {
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSort"]">Name</a>
                }
                else
                {
                    @:Name
                }
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.NPKRatio) *@
               
                @if (User.IsInRole("User") || User.IsInRole("Admin"))
                {
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["NPKSort"]">NPK</a>
                }
                else
                {
                    @:NPK
                }
            </th>
            <th>
                @* @Html.DisplayNameFor(model => model.PricePerKg) *@
                @if (User.IsInRole("User") || User.IsInRole("Admin"))
                {
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["PriceSort"]">Price</a>
                }
                else
                {
                    @:Price
                }
            </th>
            <th>
                @Html.DisplayNameFor(model => model[0].InStockQuantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model[0].IsLiquid)
            </th>
            <th>
                @Html.DisplayNameFor(model => model[0].CreatedOn)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NPKRatio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PricePerKg)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.InStockQuantity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsLiquid)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedOn)
            </td>
            <td>
                @* <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a> *@
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a>

                    @if (User.IsInRole("Admin"))
                    {
                        @: |
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        @: |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    }
            </td>
        </tr>
}
    </tbody>
</table>

@if (User.IsInRole("User") || User.IsInRole("Admin"))
{
<div class="d-flex justify-content-between mt-3">
    @if (Model.HasPreviousPage)
    {
        <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" class="btn btn-outline-primary">Previous</a>
    }
    else
    {
        <span class="btn btn-outline-secondary disabled">Previous</span>
    }

    <span>Page @Model.PageIndex of @Model.TotalPages</span>

    @if (Model.HasNextPage)
    {
        <a asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" class="btn btn-outline-primary">Next</a>
    }
    else
    {
        <span class="btn btn-outline-secondary disabled">Next</span>
    }
</div>
}
