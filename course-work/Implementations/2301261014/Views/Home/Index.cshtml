@{
    ViewData["Title"] = "Начало";
}

<!-- HERO SECTION - БЕЗ БУТОНИ -->
<div class="hero-section text-center mb-5">
    <h1 class="hero-title">
        🏁 ДОБРЕ ДОШЛИ В RACETRACK
    </h1>
    <p class="hero-subtitle">ВАШЕТО ПРИКЛЮЧЕНИЕ ЗАПОЧВА ТУК</p>
</div>

<!-- НАЛИЧНИ КОЛИ -->
<div class="section-header mb-4">
    <h2 class="display-5 text-center">
        <i class="fas fa-car"></i> НАШИТЕ КОЛИ
    </h2>
    <p class="text-center text-white-50">Премиум суперавтомобили за вашето преживяване</p>
</div>

<div class="row g-4 mb-5">
    <!-- McLaren 720S -->
    <div class="col-md-6 col-lg-4">
        <div class="car-card">
            <img src="~/images/Cars/mclaren.png" alt="McLaren 720S" class="car-image" />
            <div class="car-info">
                <h3 class="car-name">McLaren 720S</h3>
                <div class="car-specs">
                    <span><i class="fas fa-tachometer-alt"></i> 710 HP</span>
                    <span><i class="fas fa-bolt"></i> 0-100: 2.9s</span>
                    <span><i class="fas fa-gauge-high"></i> 341 km/h</span>
                </div>
                <p class="car-description">Британски суперавтомобил с карбонова MonoCell шаси и невероятна аеродинамика</p>
            </div>
        </div>
    </div>

    <!-- Bugatti Chiron -->
    <div class="col-md-6 col-lg-4">
        <div class="car-card">
            <img src="~/images/Cars/bugatti.png" alt="Bugatti Chiron" class="car-image" />
            <div class="car-info">
                <h3 class="car-name">Bugatti Chiron</h3>
                <div class="car-specs">
                    <span><i class="fas fa-tachometer-alt"></i> 1500 HP</span>
                    <span><i class="fas fa-bolt"></i> 0-100: 2.4s</span>
                    <span><i class="fas fa-gauge-high"></i> 420 km/h</span>
                </div>
                <p class="car-description">Най-мощният сериен автомобил в света с 8.0L W16 quad-turbo двигател</p>
            </div>
        </div>
    </div>

    <!-- Nissan GT-R R35 -->
    <div class="col-md-6 col-lg-4">
        <div class="car-card">
            <img src="~/images/Cars/gtr.png" alt="Nissan GT-R R35" class="car-image" />
            <div class="car-info">
                <h3 class="car-name">Nissan GT-R R35 NISMO</h3>
                <div class="car-specs">
                    <span><i class="fas fa-tachometer-alt"></i> 600 HP</span>
                    <span><i class="fas fa-bolt"></i> 0-100: 2.7s</span>
                    <span><i class="fas fa-gauge-high"></i> 315 km/h</span>
                </div>
                <p class="car-description">Японска легенда "Godzilla" с AWD и невероятни технологии</p>
            </div>
        </div>
    </div>

    <!-- Lamborghini Huracán -->
    <div class="col-md-6 col-lg-4">
        <div class="car-card">
            <img src="~/images/Cars/lamborghini.png" alt="Lamborghini Huracán" class="car-image" />
            <div class="car-info">
                <h3 class="car-name">Lamborghini Huracán STO</h3>
                <div class="car-specs">
                    <span><i class="fas fa-tachometer-alt"></i> 640 HP</span>
                    <span><i class="fas fa-bolt"></i> 0-100: 3.0s</span>
                    <span><i class="fas fa-gauge-high"></i> 310 km/h</span>
                </div>
                <p class="car-description">Италианска страст с 5.2L V10 атмосферен двигател</p>
            </div>
        </div>
    </div>

    <!-- Ferrari 488 GTB -->
    <div class="col-md-6 col-lg-4">
        <div class="car-card">
            <img src="~/images/Cars/ferrari.png" alt="Ferrari 488 GTB" class="car-image" />
            <div class="car-info">
                <h3 class="car-name">Ferrari 488 GTB</h3>
                <div class="car-specs">
                    <span><i class="fas fa-tachometer-alt"></i> 670 HP</span>
                    <span><i class="fas fa-bolt"></i> 0-100: 3.0s</span>
                    <span><i class="fas fa-gauge-high"></i> 330 km/h</span>
                </div>
                <p class="car-description">Италианска икона с twin-turbo V8 и легендарно наследство</p>
            </div>
        </div>
    </div>

    <!-- Porsche 911 GT3 RS -->
    <div class="col-md-6 col-lg-4">
        <div class="car-card">
            <img src="~/images/Cars/porsche.png" alt="Porsche 911 GT3 RS" class="car-image" />
            <div class="car-info">
                <h3 class="car-name">Porsche 911 GT3 RS</h3>
                <div class="car-specs">
                    <span><i class="fas fa-tachometer-alt"></i> 520 HP</span>
                    <span><i class="fas fa-bolt"></i> 0-100: 3.2s</span>
                    <span><i class="fas fa-gauge-high"></i> 312 km/h</span>
                </div>
                <p class="car-description">Германска прецизност с flat-6 атмосферен двигател и racing гени</p>
            </div>
        </div>
    </div>
</div>

<!-- НАЛИЧНИ ПИСТИ -->
<div class="section-header mb-4">
    <h2 class="display-5 text-center">
        <i class="fas fa-road"></i> НАШИТЕ ПИСТИ
    </h2>
    <p class="text-center text-white-50">Професионални писти за всяко ниво</p>
</div>

<div class="row g-4 mb-5">
    <!-- Silverstone -->
    <div class="col-md-6 col-lg-4">
        <div class="track-card">
            <img src="~/images/tracks/silverstone.png" alt="Silverstone Circuit" class="track-image" />
            <div class="track-info">
                <h3 class="track-name">Silverstone GP</h3>
                <p class="track-specs">
                    <i class="fas fa-ruler"></i> 5.891 км |
                    <i class="fas fa-flag-checkered"></i> 18 завоя
                </p>
                <p class="track-description">Легендарна британска писта, дом на Формула 1</p>
            </div>
        </div>
    </div>

    <!-- Nürburgring Nordschleife -->
    <div class="col-md-6 col-lg-4">
        <div class="track-card">
            <img src="~/images/tracks/nurburgring.png" alt="Nürburgring Nordschleife" class="track-image" />
            <div class="track-info">
                <h3 class="track-name">Nürburgring Nordschleife</h3>
                <p class="track-specs">
                    <i class="fas fa-ruler"></i> 20.832 км |
                    <i class="fas fa-flag-checkered"></i> 154 завоя
                </p>
                <p class="track-description">"Зеленият ад" - най-предизвикателната писта в света</p>
            </div>
        </div>
    </div>

    <!-- Spa-Francorchamps -->
    <div class="col-md-6 col-lg-4">
        <div class="track-card">
            <img src="~/images/tracks/spa.png" alt="Spa-Francorchamps" class="track-image" />
            <div class="track-info">
                <h3 class="track-name">Spa-Francorchamps</h3>
                <p class="track-specs">
                    <i class="fas fa-ruler"></i> 7.004 км |
                    <i class="fas fa-flag-checkered"></i> 19 завоя
                </p>
                <p class="track-description">Белгийска класика с легендарния Eau Rouge</p>
            </div>
        </div>
    </div>

    <!-- Donington Park -->
    <div class="col-md-6 col-lg-4">
        <div class="track-card">
            <img src="~/images/tracks/donington.png" alt="Donington Park" class="track-image" />
            <div class="track-info">
                <h3 class="track-name">Donington Park GP</h3>
                <p class="track-specs">
                    <i class="fas fa-ruler"></i> 4.023 км |
                    <i class="fas fa-flag-checkered"></i> 12 завоя
                </p>
                <p class="track-description">Историческа английска писта с богато racing наследство</p>
            </div>
        </div>
    </div>

    <!-- Laguna Seca -->
    <div class="col-md-6 col-lg-4">
        <div class="track-card">
            <img src="~/images/tracks/laguna-seca.png" alt="Laguna Seca" class="track-image" />
            <div class="track-info">
                <h3 class="track-name">Laguna Seca</h3>
                <p class="track-specs">
                    <i class="fas fa-ruler"></i> 3.602 км |
                    <i class="fas fa-flag-checkered"></i> 11 завоя
                </p>
                <p class="track-description">Калифорнийска писта с култовия Corkscrew завой</p>
            </div>
        </div>
    </div>

    <!-- Training Oval -->
    <div class="col-md-6 col-lg-4">
        <div class="track-card">
            <img src="~/images/tracks/training.png" alt="Тренировъчна писта" class="track-image" />
            <div class="track-info">
                <h3 class="track-name">Тренировъчна писта</h3>
                <p class="track-specs">
                    <i class="fas fa-ruler"></i> 2.5 км |
                    <i class="fas fa-flag-checkered"></i> 4 завоя
                </p>
                <p class="track-description">Идеална за начинаещи и тренировки</p>
            </div>
        </div>
    </div>
</div>

<!-- ПЛАНОВЕ -->
<div class="section-header mb-4">
    <h2 class="display-5 text-center">
        <i class="fas fa-trophy"></i> НАШИТЕ ПЛАНОВЕ
    </h2>
    <p class="text-center text-white-50">Изберете плана който ви подхожда</p>
</div>

<div class="row g-4 mb-5">
    <!-- Basic Plan -->
    <div class="col-md-4">
        <div class="card racing-card h-100">
            <div class="card-header racing-header text-center">
                <h3 class="mb-0">🥉 BASIC</h3>
            </div>
            <div class="card-body text-center">
                <h2 class="display-4 text-danger mb-3">200 лв</h2>
                <ul class="list-unstyled mb-4">
                    <li class="mb-2">✅ Достъп до тренировъчна писта</li>
                    <li class="mb-2">✅ 2 часа на седмица</li>
                    <li class="mb-2">✅ Базов инструктаж</li>
                    <li class="mb-2">❌ Достъп до премиум коли</li>
                    <li class="mb-2">❌ Професионални писти</li>
                </ul>
                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <a asp-controller="Booking" asp-action="BookingForm" asp-route-plan="Basic" class="btn btn-danger btn-lg w-100">
                        Резервирай
                    </a>
                }
                else
                {
                    <button class="btn btn-outline-secondary btn-lg w-100" disabled>
                        Влезте за резервация
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Premium Plan -->
    <div class="col-md-4">
        <div class="card racing-card h-100 border-danger">
            <div class="card-header racing-header text-center">
                <h3 class="mb-0">🥈 PREMIUM</h3>
            </div>
            <div class="card-body text-center">
                <h2 class="display-4 text-danger mb-3">500 лв</h2>
                <ul class="list-unstyled mb-4">
                    <li class="mb-2">✅ Всички писти</li>
                    <li class="mb-2">✅ 5 часа на седмица</li>
                    <li class="mb-2">✅ Професионален инструктор</li>
                    <li class="mb-2">✅ Достъп до премиум коли</li>
                    <li class="mb-2">❌ VIP зона</li>
                </ul>
                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <a asp-controller="Booking" asp-action="BookingForm" asp-route-plan="Premium" class="btn btn-danger btn-lg w-100">
                        Резервирай
                    </a>
                }
                else
                {
                    <button class="btn btn-outline-secondary btn-lg w-100" disabled>
                        Влезте за резервация
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- VIP Plan -->
    <div class="col-md-4">
        <div class="card racing-card h-100 border-warning">
            <div class="card-header racing-header text-center">
                <h3 class="mb-0">🥇 VIP</h3>
            </div>
            <div class="card-body text-center">
                <h2 class="display-4 text-danger mb-3">1000 лв</h2>
                <ul class="list-unstyled mb-4">
                    <li class="mb-2">✅ Всички писти 24/7</li>
                    <li class="mb-2">✅ Неограничени часове</li>
                    <li class="mb-2">✅ Личен инструктор</li>
                    <li class="mb-2">✅ Всички коли</li>
                    <li class="mb-2">✅ VIP зона + закуски</li>
                </ul>
                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <a asp-controller="Booking" asp-action="BookingForm" asp-route-plan="VIP" class="btn btn-danger btn-lg w-100">
                        Резервирай
                    </a>
                }
                else
                {
                    <button class="btn btn-outline-secondary btn-lg w-100" disabled>
                        Влезте за резервация
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- FOOTER INFO -->
<div class="text-center mt-5 mb-4">
    <p class="text-white-50">
        <i class="fas fa-phone"></i> 0888 123 456 |
        <i class="fas fa-envelope"></i> info@racetrack.bg |
        <i class="fas fa-map-marker-alt"></i> София, България
    </p>
</div>