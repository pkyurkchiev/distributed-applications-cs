@model RaceTrack.Models.User
@{
    ViewData["Title"] = "Детайли за потребител";
}

<div class="admin-header mb-4">
    <h1 class="display-5 text-white">
        <i class="fas fa-user-circle"></i> Детайли за потребител
    </h1>
</div>

<!-- ИНФОРМАЦИЯ ЗА ПОТРЕБИТЕЛЯ -->
<div class="card racing-card shadow mb-4">
    <div class="card-header racing-header">
        <h3 class="mb-0">
            <i class="fas fa-info-circle"></i> Основна информация
        </h3>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>ID:</strong> @Model.UserId</p>
                <p><strong>Пълно име:</strong> @Model.FullName</p>
                <p><strong>Потребителско име:</strong> @Model.Username</p>
                <p><strong>Email:</strong> @Model.Email</p>
            </div>
            <div class="col-md-6">
                <p><strong>Телефон:</strong> @Model.PhoneNumber</p>
                <p>
                    <strong>Ниво:</strong>
                    @if (Model.UserLevel == 2)
                    {
                        <span class="badge bg-danger">Администратор</span>
                    }
                    else
                    {
                        <span class="badge bg-info">Потребител</span>
                    }
                </p>
                <p><strong>Регистриран на:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
            </div>
        </div>

        <!-- ✅ НОВО: Управление на потребителско ниво -->
        <hr />
        <div class="row mt-3">
            <div class="col-12">
                <h5><i class="fas fa-user-shield"></i> Управление на права</h5>
                <div class="btn-group" role="group">
                    @if (Model.UserLevel == 1)
                    {
                        <form asp-action="UpdateUserLevel" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@Model.UserId" />
                            <input type="hidden" name="newLevel" value="2" />
                            <button type="submit" class="btn btn-success" onclick="return confirm('Сигурни ли сте, че искате да направите този потребител администратор?')">
                                <i class="fas fa-arrow-up"></i> Направи администратор
                            </button>
                        </form>
                    }
                    else if (Model.UserLevel == 2)
                    {
                        <form asp-action="UpdateUserLevel" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@Model.UserId" />
                            <input type="hidden" name="newLevel" value="1" />
                            <button type="submit" class="btn btn-warning" onclick="return confirm('Сигурни ли сте, че искате да премахнете администраторските права на този потребител?')">
                                <i class="fas fa-arrow-down"></i> Премахни администраторски права
                            </button>
                        </form>
                    }

                    <!-- ✅ НОВО: Бутон за изтриване на потребител -->
                    <form asp-action="DeleteUser" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.UserId" />
                        <button type="submit" class="btn btn-danger ms-2" onclick="return confirm('ВНИМАНИЕ! Това ще изтрие потребителя и всички негови резервации и документи! Сигурни ли сте?')">
                            <i class="fas fa-trash"></i> Изтрий потребител
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- РЕЗЕРВАЦИИ НА ПОТРЕБИТЕЛЯ -->
<div class="card racing-card shadow mb-4">
    <div class="card-header racing-header">
        <h3 class="mb-0">
            <i class="fas fa-calendar-check"></i> Резервации (@Model.Bookings.Count)
        </h3>
    </div>
    <div class="card-body">
        @if (Model.Bookings.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>План</th>
                            <th>Дата</th>
                            <th>Цена</th>
                            <th>Статус</th>
                            <th>Документи</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.Bookings.OrderByDescending(b => b.CreatedAt))
                        {
                            <tr>
                                <td>@booking.BookingId</td>
                                <td>@booking.Plan</td>
                                <td>@booking.BookingDate.ToString("dd.MM.yyyy")</td>
                                <td>@booking.Price лв</td>
                                <td>
                                    @if (booking.Status == "Approved")
                                    {
                                        <span class="badge bg-success">Одобрена</span>
                                    }
                                    else if (booking.Status == "Pending")
                                    {
                                        <span class="badge bg-warning">Очаква</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Отказана</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info">@booking.Documents.Count файла</span>
                                </td>
                                <td>
                                    <a asp-action="BookingDetails" asp-route-id="@booking.BookingId" class="btn btn-sm btn-danger">
                                        <i class="fas fa-eye"></i> Преглед
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> Този потребител все още няма резервации.
            </div>
        }
    </div>
</div>

<!-- КАЧЕНИ ДОКУМЕНТИ -->
<div class="card racing-card shadow mb-4">
    <div class="card-header racing-header">
        <h3 class="mb-0">
            <i class="fas fa-file-alt"></i> Качени документи
        </h3>
    </div>
    <div class="card-body">
        @if (Model.Bookings.Any(b => b.Documents.Any()))
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Файл</th>
                            <th>Тип</th>
                            <th>Резервация</th>
                            <th>Качен на</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.Bookings)
                        {
                            @foreach (var doc in booking.Documents.OrderByDescending(d => d.UploadDate))
                            {
                                <tr>
                                    <td>
                                        <i class="fas fa-file"></i> @doc.FileName
                                    </td>
                                    <td>
                                        @if (doc.DocumentType == "ID")
                                        {
                                            <span class="badge bg-info">Лична карта</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Договор</span>
                                        }
                                    </td>
                                    <td>План: @booking.Plan</td>
                                    <td>@doc.UploadDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        @if (doc.Status == "Approved")
                                        {
                                            <span class="badge bg-success">Одобрен</span>
                                        }
                                        else if (doc.Status == "Pending")
                                        {
                                            <span class="badge bg-warning">Очаква</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Отказан</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="ViewDocument" asp-route-id="@doc.DocumentId"
                                           class="btn btn-sm btn-danger" target="_blank">
                                            <i class="fas fa-eye"></i> Преглед
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle"></i> Този потребител все още няма качени документи.
            </div>
        }
    </div>
</div>

<div class="mb-4">
    <a asp-action="AllUsers" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left"></i> Назад към всички потребители
    </a>
</div>