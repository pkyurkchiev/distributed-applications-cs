@model IEnumerable<RaceTrack.Models.Booking>
@{
    ViewData["Title"] = "Админ Dashboard";
}

<!-- ADMIN HEADER -->
<div class="admin-header text-center mb-5">
    <h1 class="display-4 text-white mb-3">
        <i class="fas fa-tachometer-alt"></i> АДМИН DASHBOARD
    </h1>
    <p class="text-white-50 mb-0">Преглед на системата</p>
</div>

<!-- СТАТИСТИКИ - 6 КАРТИ -->
<div class="row g-4 mb-5">
    <!-- Общо потребители -->
    <div class="col-md-6 col-lg-4 col-xl-2">
        <div class="stat-card">
            <i class="fas fa-users"></i>
            <h3>@ViewBag.TotalUsers</h3>
            <p>Потребители</p>
        </div>
    </div>

    <!-- Общо резервации -->
    <div class="col-md-6 col-lg-4 col-xl-2">
        <div class="stat-card">
            <i class="fas fa-calendar-check"></i>
            <h3>@ViewBag.TotalBookings</h3>
            <p>Резервации</p>
        </div>
    </div>

    <!-- Чакащи резервации -->
    <div class="col-md-6 col-lg-4 col-xl-2">
        <div class="stat-card">
            <i class="fas fa-clock"></i>
            <h3>@ViewBag.PendingBookings</h3>
            <p>Чакащи</p>
        </div>
    </div>

    <!-- Приходи -->
    <div class="col-md-6 col-lg-4 col-xl-2">
        <div class="stat-card">
            <i class="fas fa-dollar-sign"></i>
            <h3>@ViewBag.TotalRevenue лв</h3>
            <p>Приходи</p>
        </div>
    </div>

    <!-- Документи -->
    <div class="col-md-6 col-lg-4 col-xl-2">
        <div class="stat-card">
            <i class="fas fa-file-alt"></i>
            <h3>@ViewBag.TotalDocuments</h3>
            <p>Документи</p>
        </div>
    </div>

    <!-- За проверка -->
    <div class="col-md-6 col-lg-4 col-xl-2">
        <div class="stat-card">
            <i class="fas fa-hourglass-half"></i>
            <h3>@ViewBag.PendingDocuments</h3>
            <p>За проверка</p>
        </div>
    </div>
</div>

<!-- БЪРЗИ ДЕЙСТВИЯ -->
<div class="row g-3 mb-5">
    <div class="col-md-4">
        <a asp-action="AllUsers" class="btn btn-danger w-100 py-3">
            <i class="fas fa-users"></i> Всички потребители
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="AllBookings" class="btn btn-danger w-100 py-3">
            <i class="fas fa-calendar"></i> Всички резервации
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="AllDocuments" class="btn btn-danger w-100 py-3">
            <i class="fas fa-file"></i> Всички документи
        </a>
    </div>
</div>

<!-- ПОСЛЕДНИ ПОТРЕБИТЕЛИ -->
<div class="racing-card mb-5">
    <div class="racing-header">
        <h3 class="mb-0">
            <i class="fas fa-user-plus"></i> Последни регистрирани потребители
        </h3>
    </div>
    <div class="card-body p-0">
        @if (ViewBag.RecentUsers != null && ((IEnumerable<RaceTrack.Models.User>)ViewBag.RecentUsers).Any())
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Име</th>
                            <th>Email</th>
                            <th>Username</th>
                            <th>Телефон</th>
                            <th>Регистриран</th>
                            <th>Ниво</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in (IEnumerable<RaceTrack.Models.User>)ViewBag.RecentUsers)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@user.UserId</span></td>
                                <td><strong class="text-danger">@user.FullName</strong></td>
                                <td>@user.Email</td>
                                <td>@user.Username</td>
                                <td>@user.PhoneNumber</td>
                                <td>@user.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (user.UserLevel == 2)
                                    {
                                        <span class="badge bg-danger">Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">User</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center">
                <i class="fas fa-user-slash fa-3x text-white-50 mb-3"></i>
                <p class="text-white-50">Няма регистрирани потребители</p>
            </div>
        }
    </div>
</div>

<!-- ПОСЛЕДНИ ДОКУМЕНТИ -->
<div class="racing-card mb-5">
    <div class="racing-header">
        <h3 class="mb-0">
            <i class="fas fa-file-upload"></i> Последни качени документи
        </h3>
    </div>
    <div class="card-body p-0">
        @if (ViewBag.RecentDocuments != null && ((IEnumerable<RaceTrack.Models.Document>)ViewBag.RecentDocuments).Any())
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Потребител</th>
                            <th>Файл</th>
                            <th>Тип</th>
                            <th>Качен на</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in (IEnumerable<RaceTrack.Models.Document>)ViewBag.RecentDocuments)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@doc.DocumentId</span></td>
                                <td><strong class="text-danger">@doc.Booking.User.FullName</strong></td>
                                <td><i class="fas fa-file-pdf text-danger"></i> @doc.FileName</td>
                                <td><span class="badge bg-info">@doc.DocumentType</span></td>
                                <td>@doc.UploadDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (doc.Status == "Pending")
                                    {
                                        <span class="badge bg-warning">За проверка</span>
                                    }
                                    else if (doc.Status == "Approved")
                                    {
                                        <span class="badge bg-success">Одобрен</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Отхвърлен</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="BookingDetails" asp-route-id="@doc.BookingId"
                                       class="btn btn-sm btn-danger">
                                        <i class="fas fa-eye"></i> Виж
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center">
                <i class="fas fa-file-excel fa-3x text-white-50 mb-3"></i>
                <p class="text-white-50">Няма качени документи</p>
            </div>
        }
    </div>
</div>

<!-- ПОСЛЕДНИ РЕЗЕРВАЦИИ -->
<div class="racing-card">
    <div class="racing-header">
        <h3 class="mb-0">
            <i class="fas fa-list"></i> Последни резервации
        </h3>
    </div>
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Дата</th>
                            <th>Клиент</th>
                            <th>План</th>
                            <th>Цена</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">#@booking.BookingId</span></td>
                                <td>@booking.BookingDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <strong class="text-danger">@booking.FullName</strong><br />
                                    <small class="text-muted">@booking.Email</small>
                                </td>
                                <td><span class="badge bg-info">@booking.Plan</span></td>
                                <td><strong class="text-danger">@booking.Price лв</strong></td>
                                <td>
                                    @if (booking.Status == "Pending")
                                    {
                                        <span class="badge bg-warning">Изчаква</span>
                                    }
                                    else if (booking.Status == "Confirmed")
                                    {
                                        <span class="badge bg-success">Потвърдена</span>
                                    }
                                    else if (booking.Status == "Completed")
                                    {
                                        <span class="badge bg-primary">Завършена</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Отказана</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="BookingDetails" asp-route-id="@booking.BookingId"
                                       class="btn btn-sm btn-danger">
                                        <i class="fas fa-eye"></i> Детайли
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center">
                <i class="fas fa-inbox fa-3x text-white-50 mb-3"></i>
                <p class="text-white-50">Няма резервации</p>
            </div>
        }
    </div>
</div>