@model IEnumerable<RaceTrack.Models.Booking>
@{
    ViewData["Title"] = "Всички резервации";
}

<div class="admin-header mb-4">
    <h1 class="display-5 text-white">
        <i class="fas fa-list"></i> Всички резервации
    </h1>
</div>

<div class="card racing-card shadow mb-4">
    <div class="card-body">
        <form method="get" asp-action="AllBookings">
            <div class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="search" class="form-control" placeholder="🔍 Търси по име, email, телефон..." value="@ViewBag.Search" />
                </div>
                <div class="col-md-3">
                    <select name="status" class="form-select">
                        <option value="">Всички статуси</option>
                        <option value="Pending" selected="@(ViewBag.Status == "Pending")">Изчакващи</option>
                        <option value="Confirmed" selected="@(ViewBag.Status == "Confirmed")">Потвърдени</option>
                        <option value="Completed" selected="@(ViewBag.Status == "Completed")">Завършени</option>
                        <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Отказани</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-racing w-100">
                        <i class="fas fa-search"></i> Търси
                    </button>
                </div>
                <div class="col-md-2">
                    <a asp-action="AllBookings" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-times"></i> Изчисти
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-dark">
        <i class="fas fa-info-circle"></i> Няма намерени резервации
    </div>
}
else
{
    <div class="card racing-card shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table racing-table mb-0">
                    <thead>
                        <tr>
                            <th><i class="fas fa-hashtag"></i> ID</th>
                            <th><i class="fas fa-calendar"></i> Дата</th>
                            <th><i class="fas fa-user"></i> Клиент</th>
                            <th><i class="fas fa-envelope"></i> Контакти</th>
                            <th><i class="fas fa-trophy"></i> План</th>
                            <th><i class="fas fa-dollar-sign"></i> Цена</th>
                            <th><i class="fas fa-info-circle"></i> Статус</th>
                            <th><i class="fas fa-cog"></i> Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model)
                        {
                            <tr>
                                <td><span class="badge bg-dark">#@booking.BookingId</span></td>
                                <td>
                                    <small>@booking.BookingDate.ToString("dd.MM.yyyy")</small><br />
                                    <small class="text-muted">@booking.BookingDate.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <strong class="text-danger">@booking.FullName</strong><br />
                                    <small class="text-muted">@booking.User.Username</small>
                                </td>
                                <td>
                                    <small><i class="fas fa-envelope"></i> @booking.Email</small><br />
                                    <small><i class="fas fa-phone"></i> @booking.Phone</small>
                                </td>
                                <td>
                                    <span class="badge
                                                @(booking.Plan == "Начинаещ" ? "plan-beginner" :
                                                                                    booking.Plan == "Напредващ" ? "plan-advanced" : "plan-pro")">
                                @booking.Plan
                            </span>
                        </td>
                        <td><strong class="text-danger">@booking.Price лв</strong></td>
                        <td>
                            @if (booking.Status == "Pending")
                                    {
                                        <span class="badge status-pending"><i class="fas fa-clock"></i> Изчаква</span>
                                    }
                                    else if (booking.Status == "Confirmed")
                                    {
                                        <span class="badge status-confirmed"><i class="fas fa-check"></i> Потвърдена</span>
                                    }
                                    else if (booking.Status == "Completed")
                                    {
                                        <span class="badge status-completed"><i class="fas fa-flag-checkered"></i> Завършена</span>
                                    }
                                    else if (booking.Status == "Cancelled")
                                    {
                                        <span class="badge status-cancelled"><i class="fas fa-times"></i> Отказана</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="BookingDetails" asp-route-id="@booking.BookingId"
                                       class="btn btn-sm btn-racing">
                                        <i class="fas fa-eye"></i> Детайли
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (ViewBag.TotalPages > 1)
            {
                <div class="card-footer racing-footer">
                    <nav>
                        <ul class="pagination justify-content-center mb-0">
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="AllBookings"
                                       asp-route-page="@i"
                                       asp-route-search="@ViewBag.Search"
                                       asp-route-status="@ViewBag.Status">
                                        @i
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
}